generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  memberships   ProjectUser[]
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String
  slug            String   @unique
  plan            String   @default("free") // "free" | "pro"
  publishableKey  String   @unique // pk_... (safe to expose to the browser)
  apiKeyHash      String          // sha256 of sk_... (never store/return the plain sk)
  apiKeyEncrypted String?         // encrypted sk_... so the dashboard can call the API server-side (never sent to the browser)
  domains         String          // comma-separated allowed origins (e.g. example.com,*.example.com)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events          Event[]
  members         ProjectUser[]
  funnels         Funnel[]
  savedViews      SavedView[]
}

model ProjectUser {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // "owner" | "member"
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Event {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @unique // event_id from the SDK — idempotency key
  projectId  String   @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type       String
  ts         DateTime
  sessionId  String
  visitorId  String
  url        String
  referrer   String?
  pagePath   String
  pageTitle  String?

  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  utmTerm    String?
  utmContent String?

  deviceType String
  os         String?
  browser    String?
  viewportWidth  Int?
  viewportHeight Int?

  formId     String?
  formName   String?

  properties String? // JSON string
  raw        String? // JSON string — original envelope (debug/replay)

  receivedAt DateTime @default(now())

  @@index([projectId, ts])
  @@index([projectId, type, ts])
  @@index([projectId, formId, ts])
  @@index([projectId, type, ts, sessionId])
}

model Funnel {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  steps     FunnelStep[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([projectId, name])
}

model FunnelStep {
  id        String  @id @default(uuid()) @db.Uuid
  funnelId  String  @db.Uuid
  funnel    Funnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  eventType String?
  formId    String?
  label     String?
  position  Int

  @@index([funnelId, position])
}

model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      String
  config    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}
