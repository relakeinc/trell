# Trell self-host / SaaS configuration.
# Copy to `.env` (gitignored) and edit. `docker compose` reads this file.
#
# NOTE ON SECRETS: every `change-me...` value below is a DUMMY placeholder
# for LOCAL Docker only — not real credentials. `db` is just the compose
# service name (only resolvable inside the compose network, unreachable
# from outside your machine). Generate real secrets (openssl commands
# included below) for any public deployment.
#
# Only the REQUIRED block is needed to boot the stack. Everything else is
# optional — the app runs without billing, AI assistant or MCP.
# Single file on purpose: compose reads the root `.env`. For `pnpm dev`
# without Docker, copy the relevant sections to apps/api/.env and
# apps/web/.env instead (see the bottom of this file).

# ---- REQUIRED ---------------------------------------------------------
# PostgreSQL (compose service `db`, local-only — see note at the top).
# Replace with your own password and keep PASSWORD and DATABASE_URL in sync.
# Any value boots local Docker; generate a real one for production:
# openssl rand -hex 32
POSTGRES_USER=trell
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=trell
POSTGRES_PORT=5432
# Same placeholder as above, as seen from inside the compose network.
DATABASE_URL=postgresql://trell:YOUR_STRONG_PASSWORD_HERE@db:5432/trell

# Public base URL of the dashboard (where users open it in a browser).
PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secret that allows creating projects via POST /v1/projects (bootstrap).
# Generate: openssl rand -hex 32
TRELL_ADMIN_KEY=change-me-admin

# Auth.js session secret (generate: openssl rand -base64 32).
AUTH_SECRET=change-me-auth-secret

# Symmetric key used to encrypt each project's secret key (sk) at rest.
# Generate: openssl rand -hex 32 — never change after projects exist.
TRELL_ENC_KEY=change-me-enc-key

# ---- Tracking snippet URLs (override in any real deployment) -----------
# Public base URL of YOUR api service, as reachable from your visitors'
# browsers. The dashboard prints these in the tracking snippets and they
# are baked in at build time (see `build.args` in docker-compose.yml).
# Localhost is fine for testing; any public deployment MUST set these to
# its own API origin, or snippets will point nowhere.
NEXT_PUBLIC_SDK_URL=http://localhost:8787/sdk/trell.js
NEXT_PUBLIC_INGEST_URL=http://localhost:8787/v1/events

# ---- API tuning (optional, defaults shown) ------------------------------
TRELL_PK_PREFIX=pk
TRELL_SK_PREFIX=sk
TRELL_RATE_LIMIT_MAX=300

# ---- Auth providers (optional) ------------------------------------------
# Google OAuth app. Callback URL must be: <PUBLIC_URL>/api/auth/callback/google
# Without these, dashboard sign-in is unavailable (use AUTH_DEV_MODE locally).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Billing via Polar (optional) ---------------------------------------
# Web (server-side). Without these, checkout/portal/billing pages are inert
# but the rest of the app works. See https://polar.sh
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# "sandbox" for testing, "production" for live charges.
POLAR_SERVER=sandbox
POLAR_PRO_MONTHLY_ID=
POLAR_PRO_YEARLY_ID=
# Monthly product id, exposed to the browser for the pricing page.
NEXT_PUBLIC_POLAR_PRO_MONTHLY_ID=

# ---- MCP, AI agent server (optional, disabled by default) ----------------
# See https://modelcontextprotocol.io and docs/mcp/
# Bearer token for the MCP HTTP endpoint. Empty = endpoint disabled.
# Generate: openssl rand -hex 32
MCP_API_KEY=
# Port the MCP listener binds (localhost only; reverse-proxy in front).
MCP_HTTP_PORT=8788
# Workspaces the MCP may access: "*" or comma-separated slugs.
MCP_ALLOWED_SLUGS=*
# Destructive tools (revoke/delete/rotate) need "true" + explicit confirm.
MCP_ALLOW_DESTRUCTIVE=false

# ---- Webchat AI assistant ("Ask Yoi", web server-side only, optional) ----
# Without keys the assistant is inert but the rest of the app works.
# Primary model provider (OpenAI-compatible).
OPENROUTER_API_KEY=
# Fallback provider.
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_FALLBACK_MODEL=orcarouter/free
# Bridge from the web app to the MCP/analytics API (server-side).
# Inside compose this is http://api:8787 (already wired in docker-compose.yml);
# with `pnpm dev` use http://localhost:8787.
MCP_URL=http://localhost:8787
# Must match the MCP stack's MCP_OAUTH_SECRET (used to sign identity JWTs).
MCP_OAUTH_SECRET=change-me-mcp-oauth-secret
# Same note as MCP_URL: compose overrides this to http://api:8787.
TRELL_API_URL=http://localhost:8787

# ---- Local dev without Docker (pnpm dev) ----------------------------------
# Copy the relevant sections above into apps/api/.env and apps/web/.env.
# Email-only sign-in without Google OAuth, for local development.
# The app refuses to boot with this enabled unless NODE_ENV=development.
# NEVER enable in production.
AUTH_DEV_MODE=false
NEXT_PUBLIC_AUTH_DEV_MODE=false
