# Trell self-host / Saas configuration.
# Copy to `.env` (gitignored) and edit. docker compose reads this file.

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=trell
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trell
POSTGRES_PORT=5432
# Connection string used by the API and the web dashboard.
DATABASE_URL=postgresql://trell:change-me@db:5432/trell

# ---- Public URLs ----------------------------------------------------------
# Public base URL the dashboard is served at (e.g. https://trell.example.com).
PUBLIC_URL=http://localhost:3000

# ---- API (ingestion) ------------------------------------------------------
# Secret that allows creating projects via POST /v1/projects (bootstrap).
TRELL_ADMIN_KEY=change-me-admin
TRELL_PK_PREFIX=pk
TRELL_SK_PREFIX=sk
TRELL_RATE_LIMIT_MAX=300

# ---- Auth (Auth.js) -------------------------------------------------------
# Auth.js session secret (generate: openssl rand -base64 32).
AUTH_SECRET=change-me-auth-secret
# Google OAuth app. Callback URL must be: <PUBLIC_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ---- Secrecy --------------------------------------------------------------
# Symmetric key used to encrypt each project's secret key (sk) at rest.
# Generate: openssl rand -hex 32 — never change after projects exist.
TRELL_ENC_KEY=change-me-enc-key
