{
  // Trell MCP en producción: sin procesos locales, sin .env, sin builds.
  // Al arrancar, VS Code te pide la key UNA vez (no se guarda en el repo).
  // Verla con:  ssh trell-vps "grep '^MCP_API_KEY=' /opt/trell-mcp/.env"
  "servers": {
    "trell-prod": {
      "type": "http",
      "url": "https://mcp.relake.co",
      "headers": {
        "Authorization": "Bearer ${input:mcp-key}"
      }
    }
  },
  "inputs": [
    {
      "id": "mcp-key",
      "type": "promptString",
      "description": "Trell MCP API key (ssh trell-vps \"grep '^MCP_API_KEY=' /opt/trell-mcp/.env\")",
      "password": true
    }
  ]
}
