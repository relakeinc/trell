{
  // Trell MCP vía mcp-remote (stdio): el proxy abre solo el navegador para el
  // login con Google, guarda los tokens y los refresca. Sin keys a mano.
  // Si pide login de nuevo o algo se atasca: borra %USERPROFILE%\.mcp-auth
  // y reinicia el servidor.
  "servers": {
    "trell": {
      "command": "npx",
      "args": [
        "-y",
        "@automattic/mcp-remote",
        "https://mcp.relake.co",
        "--transport",
        "http-only"
      ]
    }
  }
}
