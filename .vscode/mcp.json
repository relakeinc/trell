{
  // Trell MCP over local stdio. First build the API so dist/mcp-stdio.js exists:
  //   pnpm --filter @trell/api build
  // MCP_DEMO=1 runs with ephemeral in-memory data (no DB needed).
  // Against your own deployment, replace this server with an http entry
  // pointing at your MCP URL + Authorization header.
  "servers": {
    "trell": {
      "command": "node",
      "args": ["apps/api/dist/mcp-stdio.js"],
      "env": {
        "MCP_DEMO": "1"
      }
    }
  }
}
